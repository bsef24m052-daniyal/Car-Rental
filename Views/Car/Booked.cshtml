@model List<Car>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Booked Cars</h2>
    <a asp-controller="Car"
       asp-action="Index"
       class="btn btn-primary">
        Back to Cars
    </a>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No cars have been booked yet
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Car Name</th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                </tr>
            </thead>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.Name</td>
                    <td>@m.PricePerDay</td>
                    <td>
                        <span class="badge bg-warning text-black">
                            Booked
                        </span>
                    </td>
                </tr>
            }
        </table>
    </div>
}
